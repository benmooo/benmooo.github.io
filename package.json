{
  "name": "benmooo.github.io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsc --noEmit",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "lint": "eslint .",
    "lint:staged": "lint-staged",
    "publish-app:register": "node scripts/register-github-app.mjs",
    "publish-gateway:dev": "wrangler dev -c services/publish-gateway/wrangler.jsonc",
    "publish-gateway:deploy": "wrangler deploy -c services/publish-gateway/wrangler.jsonc",
    "commit": "aicommits --type conventional",
    "test": "node scripts/build-content-collections.mjs && vitest run --config vitest.config.mjs",
    "prepare": "husky && aicommits hook install"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": "eslint --fix --max-warnings=0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@content-collections/core": "^0.15.2",
    "@content-collections/mdx": "^0.2.2",
    "@content-collections/vite": "^0.3.0",
    "@fontsource/lxgw-wenkai": "^5.3.0",
    "@mdx-js/react": "3.1.1",
    "@tanstack/react-router": "1.170.17",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tanstack/react-start": "1.168.27",
    "clsx": "2.1.1",
    "github-slugger": "2.0.0",
    "katex": "0.16.25",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "7.0.1",
    "rehype-pretty-code": "0.14.1",
    "rehype-slug": "6.0.0",
    "remark-code-title": "0.2.5",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "shiki": "3.6.0",
    "tailwind-merge": "3.3.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.19",
    "@tailwindcss/vite": "4.2.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.7.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.0.1",
    "aicommits": "^3.4.0",
    "eslint": "9.37.0",
    "globals": "16.4.0",
    "husky": "^9.1.7",
    "jsdom": "27.0.1",
    "lint-staged": "^17.2.0",
    "nitro": "3.0.260311-beta",
    "tailwindcss": "4.2.2",
    "typescript": "6.0.2",
    "typescript-eslint": "8.46.0",
    "vite": "8.0.14",
    "vitest": "3.2.4",
    "wrangler": "^4.114.0"
  }
}
